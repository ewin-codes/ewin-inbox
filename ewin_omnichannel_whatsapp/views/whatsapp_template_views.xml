<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wa_template_list" model="ir.ui.view">
        <field name="name">omnichannel.whatsapp.template.list</field>
        <field name="model">omnichannel.whatsapp.template</field>
        <field name="arch" type="xml">
            <list string="WhatsApp Templates">
                <field name="account_id"/>
                <field name="name"/>
                <field name="language"/>
                <field name="category"/>
                <field name="status"/>
                <field name="variables_count"/>
            </list>
        </field>
    </record>

    <record id="view_wa_template_form" model="ir.ui.view">
        <field name="name">omnichannel.whatsapp.template.form</field>
        <field name="model">omnichannel.whatsapp.template</field>
        <field name="arch" type="xml">
            <form string="WhatsApp Template">
                <sheet>
                    <group>
                        <field name="account_id"/>
                        <field name="name"/>
                        <field name="language"/>
                        <field name="category"/>
                        <field name="status"/>
                        <field name="variables_count"/>
                    </group>
                    <field name="body_preview" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wa_template" model="ir.actions.act_window">
        <field name="name">WhatsApp Templates</field>
        <field name="res_model">omnichannel.whatsapp.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_wa_template"
              name="WhatsApp Templates"
              parent="ewin_omnichannel_core.menu_omni_config"
              action="action_wa_template"
              sequence="50"/>
</odoo>
