<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wa_send_template_wizard_form" model="ir.ui.view">
        <field name="name">omnichannel.whatsapp.send_template.wizard.form</field>
        <field name="model">omnichannel.whatsapp.send_template.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Template">
                <field name="conversation_id" invisible="1"/>
                <field name="account_id" invisible="1"/>
                <group>
                    <field name="template_id"/>
                </group>
                <field name="line_ids">
                    <list editable="bottom">
                        <field name="sequence" column_invisible="1"/>
                        <field name="name" readonly="1"/>
                        <field name="value"/>
                    </list>
                </field>
                <group>
                    <field name="preview" readonly="1" nolabel="1"/>
                </group>
                <footer>
                    <button name="action_send" string="Send" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
