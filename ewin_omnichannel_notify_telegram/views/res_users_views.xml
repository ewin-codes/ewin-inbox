<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Preferences: the self-service place to connect one's own Telegram. -->
    <record id="view_users_form_simple_modif_notify" model="ir.ui.view">
        <field name="name">res.users.preferences.telegram.notify</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='preferences']" position="after">
                <group string="EWIN Inbox Notifications"
                       groups="ewin_omnichannel_core.group_omni_operator">
                    <field name="omni_tg_chat_id" invisible="1"/>
                    <field name="omni_tg_username" readonly="1"
                           invisible="not omni_tg_username"/>
                    <!-- Outside the group's label/value columns and styled
                         as a real button: as a btn-link in a field row this
                         read as a caption, and nothing suggested that
                         pressing it opened anything. It is the one action
                         an operator ever takes here. -->
                    <div colspan="2" invisible="omni_tg_chat_id">
                        <p class="text-muted mb-2">
                            Get a personal Telegram message whenever a customer
                            writes to a conversation assigned to you. Press the
                            button, then open the link it shows and press
                            <b>Start</b> in Telegram.
                        </p>
                        <button name="action_omni_tg_link" type="object"
                                string="Connect Telegram"
                                class="btn btn-primary"
                                icon="fa-telegram"/>
                    </div>
                    <div colspan="2" invisible="not omni_tg_chat_id">
                        <p class="text-muted mb-2">
                            Connected. Notifications for your conversations
                            arrive in that Telegram chat.
                        </p>
                        <button name="action_omni_tg_unlink" type="object"
                                string="Disconnect Telegram"
                                class="btn btn-secondary"/>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Users form: an administrator onboarding somebody else. Gated on
         base.group_system, not the EWIN admin group: _omni_tg_check_own_record
         requires base.group_system to act on someone else's record, and
         issuing another person's linking credential is a system-administrator
         act. An EWIN Inbox administrator who is not a system administrator
         must not see a page whose own button would refuse them. -->
    <record id="view_users_form_notify" model="ir.ui.view">
        <field name="name">res.users.form.telegram.notify</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Inbox Notifications" groups="base.group_system">
                    <group>
                        <field name="omni_tg_username" readonly="1"/>
                        <field name="omni_tg_chat_id" readonly="1"/>
                    </group>
                    <button name="action_omni_tg_link" type="object"
                            string="Connect Telegram" class="btn-secondary"
                            invisible="omni_tg_chat_id"/>
                    <button name="action_omni_tg_unlink" type="object"
                            string="Disconnect Telegram" class="btn-link"
                            invisible="not omni_tg_chat_id"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
