<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_notifier_form" model="ir.ui.view">
        <field name="name">omnichannel.telegram.notifier.form</field>
        <field name="model">omnichannel.telegram.notifier</field>
        <field name="arch" type="xml">
            <form string="Telegram Notifier">
                <header>
                    <button name="action_check_connection" type="object"
                            string="Check Connection" class="btn-primary"/>
                    <button name="action_register_webhook" type="object"
                            string="Register Webhook"/>
                    <button name="action_remove_webhook" type="object"
                            string="Remove Webhook"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group string="Bot">
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="bot_token" password="True"
                                   groups="ewin_omnichannel_core.group_omni_admin"/>
                            <field name="bot_token_masked"
                                   groups="!ewin_omnichannel_core.group_omni_admin"/>
                            <field name="bot_username" readonly="1"/>
                            <field name="bot_external_id" readonly="1"/>
                            <field name="api_base_url" groups="base.group_no_one"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Delivery">
                            <field name="group_chat_id"/>
                            <field name="throttle_minutes"/>
                            <field name="webhook_status" readonly="1"/>
                            <field name="webhook_uuid" readonly="1"
                                   groups="base.group_no_one"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="state != 'error'">
                        <field name="last_error" nolabel="1" readonly="1"/>
                    </group>
                    <!-- Setting this up runs across three places: Odoo,
                         @BotFather and the team's Telegram group. Each step
                         shows only while it is the one still to do, so the
                         panel tells you where you are instead of making you
                         re-read the whole procedure every time. The note
                         about operators stays: people join over time, and
                         nothing on this form ever marks it finished. -->
                    <div class="alert alert-info" role="status"
                         invisible="bot_username">
                        <b>Step 1 of 3 - the bot.</b>
                        Create one with
                        <a href="https://t.me/BotFather" target="_blank">@BotFather</a>,
                        paste its token below, save, and press
                        <b>Check Connection</b>. It has to be a
                        <b>different bot</b> from the one a Telegram channel
                        uses to talk to customers - everybody who presses
                        Start in that one becomes a customer in the Inbox.
                    </div>
                    <div class="alert alert-info" role="status"
                         invisible="not bot_username or webhook_status == 'registered'">
                        <b>Step 2 of 3 - the webhook.</b>
                        Press <b>Register Webhook</b> so Telegram delivers this
                        bot's updates here. Nothing below works until it does:
                        every command reaches Odoo through it.
                    </div>
                    <div class="alert alert-info" role="status"
                         invisible="webhook_status != 'registered' or group_chat_id">
                        <b>Step 3 of 3 - the team's group.</b>
                        Add the bot to the group as an <b>administrator</b>
                        (its username is under Bot, below), then send
                        <b>/register</b> in that group. The bot answers there
                        and fills in Group Chat ID itself - the number is not
                        something to look up and type. It accepts the command
                        only from someone who has connected their own Telegram
                        and holds <i>EWIN Inbox / Administrator</i>.
                    </div>
                    <div class="alert alert-secondary" role="status"
                         invisible="webhook_status != 'registered'">
                        <b>How an operator gets their own notifications.</b>
                        Nobody types a username or a chat id anywhere. Each
                        person opens their own <i>Preferences → EWIN Inbox
                        Notifications → Connect Telegram</i>, follows the
                        one-time link it shows and presses Start in Telegram.
                        Until someone does that, their conversations notify the
                        group chat instead of them.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telegram_notifier_list" model="ir.ui.view">
        <field name="name">omnichannel.telegram.notifier.list</field>
        <field name="model">omnichannel.telegram.notifier</field>
        <field name="arch" type="xml">
            <list string="Telegram Notifiers">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="bot_username"/>
                <field name="group_chat_id"/>
                <field name="throttle_minutes"/>
                <field name="state"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_telegram_notifier" model="ir.actions.act_window">
        <field name="name">Telegram Notifications</field>
        <field name="res_model">omnichannel.telegram.notifier</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up the notification bot</p>
            <p>
                Create a bot with @BotFather, paste its token here, press Check
                Connection, then Register Webhook. This bot notifies your team;
                it is not the bot customers write to.
            </p>
        </field>
    </record>
</odoo>
