<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_telegram_notifier_form" model="ir.ui.view">
        <field name="name">omnichannel.telegram.notifier.form</field>
        <field name="model">omnichannel.telegram.notifier</field>
        <field name="arch" type="xml">
            <form string="Telegram Notifier">
                <header>
                    <button name="action_check_connection" type="object"
                            string="Check Connection" class="btn-primary"/>
                    <button name="action_register_webhook" type="object"
                            string="Register Webhook"/>
                    <button name="action_remove_webhook" type="object"
                            string="Remove Webhook"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,connected"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <group>
                        <group string="Bot">
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="bot_token" password="True"
                                   groups="ewin_omnichannel_core.group_omni_admin"/>
                            <field name="bot_token_masked"
                                   groups="!ewin_omnichannel_core.group_omni_admin"/>
                            <field name="bot_username" readonly="1"/>
                            <field name="bot_external_id" readonly="1"/>
                            <field name="api_base_url" groups="base.group_no_one"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Delivery">
                            <field name="group_chat_id"/>
                            <field name="throttle_minutes"/>
                            <field name="webhook_status" readonly="1"/>
                            <field name="webhook_uuid" readonly="1"
                                   groups="base.group_no_one"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="state != 'error'">
                        <field name="last_error" nolabel="1" readonly="1"/>
                    </group>
                    <field name="my_telegram_connected" invisible="1"/>
                    <!-- Four acts across three places: Odoo, @BotFather and
                         the team's chat. Each step shows only while it is
                         the one still to do - including step 3, which is
                         about the person reading the form rather than the
                         record, and so uses my_telegram_connected. What is
                         on screen is what is left. -->
                    <div class="alert alert-success" role="status"
                         invisible="not bot_username or webhook_status != 'registered' or not group_chat_id or not my_telegram_connected">
                        <b>Set up.</b> A customer message notifies the
                        assigned operator personally, or
                        <b><field name="group_chat_id" readonly="1" nolabel="1"
                        class="oe_inline"/></b> when there is nobody to notify.
                        A conversation notifies at most once every
                        <b><field name="throttle_minutes" readonly="1"
                        nolabel="1" class="oe_inline"/></b> minutes; its first
                        message always does. Delivery goes through the job
                        queue, so allow up to a minute.
                    </div>
                    <div class="alert alert-info" role="status"
                         invisible="bot_username">
                        <b>Step 1 of 4 — the bot.</b>
                        <p class="mb-1">
                            Open
                            <a href="https://t.me/BotFather" target="_blank">@BotFather</a>
                            in Telegram, send <b>/newbot</b>, answer its two
                            questions and copy the token it gives you. Paste
                            that token into <b>Bot Token</b> above, save, and
                            press <b>Check Connection</b>.
                        </p>
                        <p class="mb-0">
                            It has to be a bot of its own. The bot a Telegram
                            <i>channel</i> uses to talk to customers cannot
                            also do this job: every colleague who pressed
                            Start there would turn into a customer in the
                            Inbox, with a contact and a conversation of their
                            own.
                        </p>
                    </div>
                    <div class="alert alert-info" role="status"
                         invisible="not bot_username or webhook_status == 'registered'">
                        <b>Step 2 of 4 — the webhook.</b>
                        <p class="mb-0">
                            Press <b>Register Webhook</b>. That is how Telegram
                            learns where to deliver this bot's messages.
                            Nothing below works until it does: every command
                            you type in Telegram reaches Odoo through it.
                        </p>
                    </div>
                    <div class="alert alert-info" role="status"
                         invisible="webhook_status != 'registered' or my_telegram_connected">
                        <b>Step 3 of 4 — your own notifications.</b>
                        <p class="mb-1">
                            Open your own preferences — your name in the top
                            right, then <b>Preferences</b> — and find
                            <b>EWIN Inbox Notifications</b>. Press
                            <b>Connect Telegram</b>: a link appears, click it,
                            Telegram opens on the bot, press <b>Start</b>
                            there. That is the whole binding. Nobody types a
                            username or a chat id anywhere, here or in
                            Telegram.
                        </p>
                        <p class="mb-1">
                            From then on you get a personal message for every
                            customer message in a conversation assigned to
                            you. Every operator does this once, for
                            themselves.
                        </p>
                        <p class="mb-0">
                            Do it before step 4: <b>/register</b> is accepted
                            only from someone who has already connected their
                            own Telegram.
                        </p>
                    </div>
                    <div class="alert alert-info" role="status"
                         invisible="webhook_status != 'registered' or not my_telegram_connected or group_chat_id">
                        <b>Step 4 of 4 — the team's chat.</b>
                        <p class="mb-1">
                            Add the bot to the chat your team shares and make
                            it an <b>administrator</b> there. Then send
                            <b>/register</b> in that chat. The bot answers in
                            the chat and fills in <b>Group Chat ID</b> itself —
                            that number is not something to look up, Telegram
                            shows it nowhere.
                        </p>
                        <p class="mb-0">
                            That chat is the floor under the notifications:
                            everything with nobody to notify personally lands
                            there — a conversation no operator has taken yet,
                            and one whose operator has not done step 3.
                        </p>
                    </div>
                    <div class="alert alert-secondary" role="status"
                         invisible="webhook_status != 'registered' or not group_chat_id or my_telegram_connected">
                        <b>You are not connected yourself.</b>
                        The group chat is set, so nothing is lost — but your
                        own conversations notify the group instead of you.
                        Connect your Telegram under
                        <i>Preferences → EWIN Inbox Notifications</i>. Every
                        operator does it once, for themselves.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_telegram_notifier_list" model="ir.ui.view">
        <field name="name">omnichannel.telegram.notifier.list</field>
        <field name="model">omnichannel.telegram.notifier</field>
        <field name="arch" type="xml">
            <list string="Telegram Notifiers">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="bot_username"/>
                <field name="group_chat_id"/>
                <field name="throttle_minutes"/>
                <field name="state"
                       decoration-success="state == 'connected'"
                       decoration-danger="state == 'error'"
                       widget="badge"/>
            </list>
        </field>
    </record>

    <record id="action_telegram_notifier" model="ir.actions.act_window">
        <field name="name">Telegram Notifications</field>
        <field name="res_model">omnichannel.telegram.notifier</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Set up the notification bot</p>
            <p>
                Create a bot with @BotFather, paste its token here, press Check
                Connection, then Register Webhook. This bot notifies your team;
                it is not the bot customers write to.
            </p>
        </field>
    </record>
</odoo>
