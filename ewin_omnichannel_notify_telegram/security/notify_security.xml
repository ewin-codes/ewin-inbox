<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- omnichannel.telegram.link carries a live linking token in plain text
         (the https://t.me/<bot>?start=<token> URL): whoever can read a
         wizard row receives that user's Telegram notifications from then on.
         Odoo does NOT scope transient models to their creator on its own —
         with no ir.rule here, every group_omni_operator user can read, via
         search_read, every other operator's outstanding link. This rule is
         what actually enforces "only the person it was made for" once the
         ACL above grants the group read access to the model at all. -->
    <record id="rule_telegram_link_own" model="ir.rule">
        <field name="name">Telegram link: own wizard only</field>
        <field name="model_id" ref="model_omnichannel_telegram_link"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="global" eval="True"/>
    </record>

    <!-- Every ewin_omnichannel_core model that carries company_id has a
         global company rule (see omnichannel_security.xml's
         rule_conversation_company and friends). This model is no different:
         without one, a company-B administrator who opens Telegram
         Notifications sees company A's record too — bot_token and
         webhook_secret are closed by group, not by company, so they would
         read a bot token, and the webhook secret, that is not theirs. -->
    <record id="rule_notifier_company" model="ir.rule">
        <field name="name">Telegram notifier: company</field>
        <field name="model_id" ref="model_omnichannel_telegram_notifier"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
