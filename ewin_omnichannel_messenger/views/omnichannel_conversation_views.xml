<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_conversation_form_messenger" model="ir.ui.view">
        <field name="name">omnichannel.conversation.form.messenger</field>
        <field name="model">omnichannel.conversation</field>
        <field name="inherit_id"
               ref="ewin_omnichannel_core.view_conversation_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="mg_is_messenger" invisible="1"/>
                <field name="mg_window_closed" invisible="1"/>
            </header>
            <div class="o_omni_composer" position="before">
                <div class="alert alert-warning mb-1" role="alert"
                     invisible="not mg_window_closed">
                    The 24-hour messaging window looks closed — Messenger only
                    allows free-form replies within 24 hours of the customer's
                    last message. The customer must reply before you can
                    message them again.
                </div>
            </div>
        </field>
    </record>
</odoo>
