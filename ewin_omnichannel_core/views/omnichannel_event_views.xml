<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_list" model="ir.ui.view">
        <field name="name">omnichannel.event.list</field>
        <field name="model">omnichannel.event</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="received_at"/>
                <field name="account_id"/>
                <field name="external_event_id"/>
                <field name="event_type"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_event_form" model="ir.ui.view">
        <field name="name">omnichannel.event.form</field>
        <field name="model">omnichannel.event</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="account_id"/>
                            <field name="external_event_id"/>
                            <field name="event_type"/>
                            <field name="state" widget="badge"/>
                        </group>
                        <group>
                            <field name="received_at"/>
                            <field name="processed_at"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Error">
                        <field name="error"/>
                    </group>
                    <group string="Payload">
                        <field name="payload" widget="jsonb"
                               groups="ewin_omnichannel_core.group_omni_admin"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_event" model="ir.actions.act_window">
        <field name="name">Events</field>
        <field name="res_model">omnichannel.event</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
