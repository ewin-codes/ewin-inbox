<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_message_list" model="ir.ui.view">
        <field name="name">omnichannel.message.list</field>
        <field name="model">omnichannel.message</field>
        <field name="arch" type="xml">
            <list create="0">
                <field name="received_at"/>
                <field name="conversation_id"/>
                <field name="account_id"/>
                <field name="direction"/>
                <field name="sender_type"/>
                <field name="message_type"/>
                <field name="is_internal"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_message_form" model="ir.ui.view">
        <field name="name">omnichannel.message.form</field>
        <field name="model">omnichannel.message</field>
        <field name="arch" type="xml">
            <form create="0">
                <sheet>
                    <group>
                        <group>
                            <field name="conversation_id"/>
                            <field name="account_id"/>
                            <field name="direction"/>
                            <field name="sender_type"/>
                            <field name="message_type"/>
                            <field name="is_internal"/>
                            <field name="author_partner_id"/>
                        </group>
                        <group>
                            <field name="state" widget="badge"/>
                            <field name="received_at"/>
                            <field name="sent_at"/>
                            <field name="delivered_at"/>
                            <field name="read_at"/>
                            <field name="retry_count"/>
                            <field name="next_retry_at"/>
                            <field name="scheduled_at"
                                   invisible="not scheduled_at"/>
                            <field name="scheduled_by"
                                   invisible="not scheduled_by"/>
                        </group>
                    </group>
                    <group string="Content">
                        <field name="body"/>
                        <field name="attachment_ids" widget="many2many_binary"/>
                    </group>
                    <group string="Technical">
                        <field name="external_message_id"/>
                        <field name="external_reply_to_id"/>
                        <field name="reply_to_id"/>
                        <field name="mail_message_id"/>
                        <field name="error_code"/>
                        <field name="error_message"/>
                        <field name="raw_payload" widget="jsonb"
                               groups="ewin_omnichannel_core.group_omni_admin"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_message" model="ir.actions.act_window">
        <field name="name">Messages</field>
        <field name="res_model">omnichannel.message</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_message_scheduled_list" model="ir.ui.view">
        <field name="name">omnichannel.message.scheduled.list</field>
        <field name="model">omnichannel.message</field>
        <field name="arch" type="xml">
            <!-- Every pending send across all conversations. Ordered by when it
                 goes out, not by id: this list is read as a timetable. -->
            <list create="0" delete="0" editable="bottom"
                  default_order="scheduled_at">
                <field name="scheduled_at" string="Sends at"/>
                <field name="conversation_id" readonly="1"/>
                <field name="account_id" readonly="1" optional="show"/>
                <field name="body" widget="html" string="Reply" readonly="1"/>
                <field name="scheduled_by" readonly="1"/>
                <field name="company_id" readonly="1"
                       groups="base.group_multi_company"/>
                <button name="action_send_now" type="object"
                        icon="fa-paper-plane" title="Send now"/>
                <button name="action_cancel_schedule" type="object"
                        icon="fa-times" title="Cancel"/>
            </list>
        </field>
    </record>

    <record id="action_message_scheduled" model="ir.actions.act_window">
        <field name="name">Scheduled</field>
        <field name="res_model">omnichannel.message</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'scheduled')]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 1, 'view_mode': 'list',
                    'view_id': ref('view_message_scheduled_list')}),
            (0, 0, {'sequence': 2, 'view_mode': 'form',
                    'view_id': ref('view_message_form')})]"/>
    </record>
</odoo>
