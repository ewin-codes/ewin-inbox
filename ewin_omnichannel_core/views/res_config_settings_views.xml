<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- An own *primary* view here would replace the whole Settings screen:
         the Settings action carries no view_id, so Odoo takes the first
         primary form of res.config.settings ordered by priority, name, id.
         Our settings are one block of the standard form, like every other
         module's. -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ewin.omnichannel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="EWIN Inbox" string="EWIN Inbox"
                     name="ewin_omnichannel_core">
                    <block title="Composer" name="omni_composer_setting_container">
                        <setting id="omni_send_shortcut_setting"
                                 string="Send message with"
                                 help="With Ctrl+Enter, plain Enter inserts a newline.">
                            <field name="omni_send_shortcut" widget="radio"/>
                        </setting>
                    </block>
                    <block title="Closing" name="omni_closing_setting_container">
                        <setting id="omni_close_reason_setting"
                                 string="Closing reason"
                                 help="Ask the operator why a conversation is being closed.">
                            <field name="omni_close_reason_policy" widget="radio"/>
                            <div class="mt8">
                                <button name="%(action_close_reason)d" type="action"
                                        string="Close Reasons" icon="oi-arrow-right"
                                        class="btn-link"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Configuration → Settings: `module` selects the block above as the
         initial tab of the standard Settings screen. -->
    <record id="action_omni_settings" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'ewin_omnichannel_core'}</field>
    </record>
</odoo>
