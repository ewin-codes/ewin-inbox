<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tag_list" model="ir.ui.view">
        <field name="name">omnichannel.tag.list</field>
        <field name="model">omnichannel.tag</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="view_tag_form" model="ir.ui.view">
        <field name="name">omnichannel.tag.form</field>
        <field name="model">omnichannel.tag</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_tag" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">omnichannel.tag</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
