<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_team_list" model="ir.ui.view">
        <field name="name">omnichannel.team.list</field>
        <field name="model">omnichannel.team</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="manager_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_team_form" model="ir.ui.view">
        <field name="name">omnichannel.team.form</field>
        <field name="model">omnichannel.team</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="manager_id"/>
                <field name="user_ids" widget="many2many_tags"/>
                <field name="active"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">omnichannel.team</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
