<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_channel_list" model="ir.ui.view">
        <field name="name">omnichannel.channel.list</field>
        <field name="model">omnichannel.channel</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="code"/><field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_channel_form" model="ir.ui.view">
        <field name="name">omnichannel.channel.form</field>
        <field name="model">omnichannel.channel</field>
        <field name="arch" type="xml">
            <form><sheet><group>
                <field name="name"/><field name="code"/>
                <field name="connector_module"/><field name="active"/>
                <field name="capabilities" widget="jsonb"/>
            </group></sheet></form>
        </field>
    </record>
    <record id="action_channel" model="ir.actions.act_window">
        <field name="name">Channels</field>
        <field name="res_model">omnichannel.channel</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
