<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_form" model="ir.ui.view">
        <field name="name">omnichannel.account.form</field>
        <field name="model">omnichannel.account</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet><group>
                    <group>
                        <field name="name"/><field name="channel_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="default_team_id"/>
                        <field name="default_user_id"/>
                        <field name="webhook_uuid" readonly="1"/>
                        <field name="last_webhook_at" readonly="1"/>
                    </group>
                </group>
                <field name="last_error" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_account_list" model="ir.ui.view">
        <field name="name">omnichannel.account.list</field>
        <field name="model">omnichannel.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="channel_id"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>
    <record id="action_account" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">omnichannel.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
