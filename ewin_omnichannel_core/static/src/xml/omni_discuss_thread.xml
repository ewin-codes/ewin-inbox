<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ewin_omnichannel_core.Thread" t-inherit="mail.Thread" t-inherit-mode="primary">
        <xpath expr="//Message" position="attributes">
            <attribute name="hasActions">false</attribute>
        </xpath>
    </t>

    <t t-name="ewin_omnichannel_core.OmniDiscussThreadField">
        <div class="o_omni_thread_panel d-flex flex-column border rounded">
            <Thread t-if="this.thread()" thread="this.thread()"
                    jumpPresent="this.jumpPresent()"/>
            <div t-else="" class="o_omni_thread_empty d-flex align-items-center justify-content-center text-muted p-4">
                <i class="oi me-2" data-icon="forum"/> No messages in this conversation yet.
            </div>
        </div>
    </t>
</templates>
