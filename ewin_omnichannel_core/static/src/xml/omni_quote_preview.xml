<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ewin_omnichannel_core.OmniQuotePreviewField">
        <div class="o_omni_quote_preview">
            <button type="button" class="o_omni_quote_toggle btn btn-light btn-sm"
                    t-att-aria-expanded="state.open ? 'true' : 'false'"
                    title="Show or hide what is sent with this reply"
                    t-on-click="toggle">•••</button>
            <div t-if="state.open" class="o_omni_quote_body" t-out="html"/>
        </div>
    </t>
</templates>
