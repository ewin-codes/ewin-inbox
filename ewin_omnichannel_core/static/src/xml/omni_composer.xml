<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="ewin_omnichannel_core.OmniComposerField">
        <div class="o_omni_composer_wrap">
            <!-- One box, as in a mail client: the reply, its signature and,
                 folded under them, what the channel sends with it. -->
            <div class="o_omni_composer_box form-control" t-on-click="this.onBoxClick">
                <textarea class="o_omni_composer_input"
                          t-ref="this.textareaRef"
                          rows="2"
                          t-att-placeholder="this.props.placeholder"
                          t-on-input="this.onInput"
                          t-on-keydown="this.onKeydown"
                          t-on-focus="this.placeCaret"
                          t-on-mouseup="this.placeCaret"/>
                <t t-if="this.hasQuote">
                    <button type="button" class="o_omni_quote_toggle btn btn-light btn-sm"
                            title="Show or hide what is sent with this reply"
                            t-att-aria-expanded="this.state.quoteOpen ? 'true' : 'false'"
                            t-on-click="this.toggleQuote">•••</button>
                    <div t-if="this.state.quoteOpen" class="o_omni_quote_editor"
                         contenteditable="true" t-ref="this.quoteRef"
                         t-on-input="this.onQuoteInput"/>
                </t>
            </div>
        </div>
    </t>
</templates>
