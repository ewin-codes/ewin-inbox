<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_process_jobs" model="ir.cron">
        <field name="name">Omnichannel: Process job queue</field>
        <field name="model_id" ref="model_omnichannel_job"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_jobs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="cron_cleanup_events" model="ir.cron">
        <field name="name">Omnichannel: Cleanup old events and logs</field>
        <field name="model_id" ref="model_omnichannel_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_cleanup()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
