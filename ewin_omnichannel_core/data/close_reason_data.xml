<?xml version="1.0" encoding="utf-8"?>
<!-- noupdate: an administrator renaming or archiving a shipped reason must
     not have it reset on the next module upgrade. company_id is left empty
     on purpose so every company gets the same starting list. -->
<odoo noupdate="1">
    <record id="close_reason_resolved" model="omnichannel.close.reason">
        <field name="name">Resolved</field>
        <field name="sequence">10</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="close_reason_no_answer" model="omnichannel.close.reason">
        <field name="name">No answer from customer</field>
        <field name="sequence">20</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="close_reason_duplicate" model="omnichannel.close.reason">
        <field name="name">Duplicate</field>
        <field name="sequence">30</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="close_reason_elsewhere" model="omnichannel.close.reason">
        <field name="name">Handled elsewhere</field>
        <field name="sequence">40</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="close_reason_spam" model="omnichannel.close.reason">
        <field name="name">Spam</field>
        <field name="sequence">50</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
