<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_conversation_form_instagram" model="ir.ui.view">
        <field name="name">omnichannel.conversation.form.instagram</field>
        <field name="model">omnichannel.conversation</field>
        <field name="inherit_id"
               ref="ewin_omnichannel_core.view_conversation_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="ig_is_instagram" invisible="1"/>
                <field name="ig_window_closed" invisible="1"/>
            </header>
            <div class="o_omni_composer" position="before">
                <div class="alert alert-warning mb-1" role="alert"
                     invisible="not ig_window_closed">
                    The 24-hour messaging window looks closed — Instagram only
                    allows free-form replies within 24 hours of the customer's
                    last message. The customer must reply before you can message
                    them again (unless the Human Agent tag is enabled on the
                    account, which extends the window to 7 days).
                </div>
            </div>
        </field>
    </record>
</odoo>
