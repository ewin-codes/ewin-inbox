<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_conversation_form_crm" model="ir.ui.view">
        <field name="name">omnichannel.conversation.form.crm</field>
        <field name="model">omnichannel.conversation</field>
        <field name="inherit_id"
               ref="ewin_omnichannel_core.view_conversation_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_set_pending']"
                   position="before">
                <button name="action_create_lead" string="Create Lead"
                        type="object" invisible="lead_id"
                        groups="sales_team.group_sale_salesman"/>
            </xpath>
            <!-- Anchored with an explicit xpath, not `<field name="partner_id"
                 position="after">`: partner_id appears twice in the parent
                 arch and the plain locator matches the first one, which is the
                 read-only copy inside the collapsed <summary>. -->
            <xpath expr="//details//group//field[@name='partner_id']"
                   position="after">
                <field name="lead_id"
                       options="{'no_quick_create': True}"
                       domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_conversation_list_crm" model="ir.ui.view">
        <field name="name">omnichannel.conversation.list.crm</field>
        <field name="model">omnichannel.conversation</field>
        <field name="inherit_id"
               ref="ewin_omnichannel_core.view_conversation_list"/>
        <field name="arch" type="xml">
            <field name="team_id" position="after">
                <field name="lead_id" optional="hide"/>
            </field>
        </field>
    </record>

    <record id="view_conversation_search_crm" model="ir.ui.view">
        <field name="name">omnichannel.conversation.search.crm</field>
        <field name="model">omnichannel.conversation</field>
        <field name="inherit_id"
               ref="ewin_omnichannel_core.view_conversation_search"/>
        <field name="arch" type="xml">
            <filter name="no_contact" position="after">
                <filter name="no_lead" string="No lead"
                        domain="[('lead_id','=',False)]"/>
            </filter>
            <filter name="g_close_reason" position="after">
                <filter name="g_lead" string="Lead"
                        context="{'group_by':'lead_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
