<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_conversation_link_wizard_form" model="ir.ui.view">
        <field name="name">omnichannel.conversation.link.wizard.form</field>
        <field name="model">omnichannel.conversation.link.wizard</field>
        <field name="arch" type="xml">
            <form string="Link Conversations">
                <field name="lead_id" invisible="1"/>
                <field name="lead_partner_id" invisible="1"/>
                <group>
                    <!-- active_test: False lets the picker reach an archived
                         conversation too, same as core's contact form. -->
                    <field name="conversation_ids" nolabel="1"
                           widget="many2many"
                           domain="[('lead_id', '=', False)]"
                           context="{'search_default_partner_id': lead_partner_id,
                                     'active_test': False}"/>
                </group>
                <footer>
                    <button name="action_confirm" string="Link" type="object"
                            class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
